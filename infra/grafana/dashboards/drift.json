{
  "id": null,
  "uid": "demand-forecast-drift",
  "title": "Demand Forecast — Feature Drift",
  "tags": ["demand-forecast", "drift"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last Drift Check",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "dateTimeAsIso", "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_job_last_run_timestamp * 1000",
          "legendFormat": "Last Check"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last Check Duration (s)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s", "decimals": 1, "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_job_duration_seconds",
          "legendFormat": "Duration"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reference Rows (last check)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_job_reference_count",
          "legendFormat": "Reference"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Current Rows (last check)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "thresholds"}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_job_current_count",
          "legendFormat": "Current"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Drift Score by Feature",
      "description": "Wasserstein distance (normed). Lower = closer to reference distribution. Evidently flags drift when score > threshold (default ~0.1 for Wasserstein).",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 4, "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_score",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Drift Detected (current)",
      "description": "1 = Evidently detected drift on the last check, 0 = no drift",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "OK", "color": "green"}, "1": {"text": "DRIFT", "color": "red"}}}
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "horizontal",
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_detected",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Drift Detected Over Time (1 = drift, 0 = stable)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "drift_detected",
          "legendFormat": "{{feature}}"
        }
      ]
    }
  ],
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {}
}
