# Shared Python base image for all services.
#
# Build (from repo root):
#   make build-base
#   docker build -f libs/Dockerfile.base -t forecast-base:latest .
#
# Services inherit with:
#   FROM forecast-base:latest

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install uv from the official distroless image (no pip required)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Non-root user that services will run as
RUN useradd -m -u 1000 app

WORKDIR /app

# Install the common library (and its transitive deps) system-wide so every
# service that inherits this image can import from `common.*` without an
# extra install step.
COPY libs/common /app/libs/common
RUN uv pip install --system --no-cache /app/libs/common

# Services add their own COPY + install layers on top of this.
