# Copy this file to .env and fill in values before running `make up`.
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=forecast
POSTGRES_USER=forecast
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=changeme

# ---------------------------------------------------------------------------
# mock-weather chaos controls (core profile)
# ---------------------------------------------------------------------------
FAULT_LATENCY_MS=0
FAULT_ERROR_RATE=0
FAULT_NULL_FIELD_RATE=0
FAULT_SCHEMA_DRIFT=false

# ---------------------------------------------------------------------------
# event-generator + weather-poller (stream profile)
# ---------------------------------------------------------------------------
GENERATOR_CITIES=london,new_york,tokyo,sydney,dubai
GENERATOR_TICK_INTERVAL_S=1.0
GENERATOR_SIM_SPEED=3600.0
# GENERATOR_SIM_START=2024-01-01T00:00:00Z
POLLER_POLL_INTERVAL_S=30.0

# ---------------------------------------------------------------------------
# MinIO (core profile)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Non-root service account created by minio-init (used by all app services).
# Must be at least 3 chars (key) / 8 chars (secret).
MINIO_SVC_ACCESS_KEY=svc-lake
MINIO_SVC_SECRET_KEY=changeme-svc-lake

# ---------------------------------------------------------------------------
# ml profile  (clickhouse, mlflow, trainer)
# ---------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=clickhouse

# MLflow tracking server — accessible on the host after `make up-ml`.
# Services inside Docker use http://mlflow:5000 (set per-service in compose).
MLFLOW_TRACKING_URI=http://localhost:5001

# Trainer knobs (optional overrides; defaults shown)
# TRAINING_LOOKBACK_DAYS=30
# TRAINER_VAL_DAYS=7

# ---------------------------------------------------------------------------
# obs profile  (prometheus, grafana, pushgateway, drift)
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD=admin
# When the obs profile is running, point the trainer at pushgateway so
# model metrics survive after the one-shot trainer container exits.
PUSHGATEWAY_URL=http://pushgateway:9091

# ---------------------------------------------------------------------------
# ui profile  (api, ingestion, forecaster, frontend)
# ---------------------------------------------------------------------------
# SECRET_KEY=changeme
# WEATHER_API_KEY=changeme
