# Copy this file to .env and fill in values before running `make up`.
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=forecast
POSTGRES_USER=forecast
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=changeme

# ---------------------------------------------------------------------------
# ml profile  (clickhouse, minio, mlflow)
# ---------------------------------------------------------------------------
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=changeme
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=changeme

# ---------------------------------------------------------------------------
# ui profile  (api, ingestion, forecaster, frontend)
# ---------------------------------------------------------------------------
# SECRET_KEY=changeme
# WEATHER_API_KEY=changeme
