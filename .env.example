# Copy this file to .env and fill in values before running `make up`.
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=forecast
POSTGRES_USER=forecast
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=changeme

# ---------------------------------------------------------------------------
# mock-weather chaos controls (core profile)
# ---------------------------------------------------------------------------
FAULT_LATENCY_MS=0
FAULT_ERROR_RATE=0
FAULT_NULL_FIELD_RATE=0
FAULT_SCHEMA_DRIFT=false

# ---------------------------------------------------------------------------
# event-generator (core profile)
# ---------------------------------------------------------------------------
GENERATOR_CITIES=london,new_york,tokyo,sydney,dubai
GENERATOR_TICK_INTERVAL_S=1.0
GENERATOR_SIM_SPEED=3600.0
# GENERATOR_SIM_START=2024-01-01T00:00:00Z

# ---------------------------------------------------------------------------
# ml profile  (clickhouse, minio, mlflow)
# ---------------------------------------------------------------------------
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=changeme
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=changeme

# ---------------------------------------------------------------------------
# ui profile  (api, ingestion, forecaster, frontend)
# ---------------------------------------------------------------------------
# SECRET_KEY=changeme
# WEATHER_API_KEY=changeme
